# =============================================================================
# WorkPulse — متغیرهای محیطی
# این فایل را کپی کنید: cp .env.example .env
# هرگز فایل .env را در Git قرار ندهید.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=workpulse
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=workpulse
POSTGRES_PORT=5432

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# اتصال دیتابیس (داخل Docker از نام سرویس postgres استفاده می‌شود)
DATABASE_URL=postgresql://workpulse:change_me_strong_password@postgres:5432/workpulse?schema=public

# JWT — حتماً در Production مقدار تصادفی و قوی تنظیم کنید
JWT_SECRET=change_me_jwt_secret_min_32_chars_long!!
JWT_EXPIRES_IN=8h

# رمزگذاری توکن GitLab (AES-256-GCM) — در Production الزامی
ENCRYPTION_KEY=change_me_encryption_key_min_32_chars

# اعتبارسنجی Webhook GitLab (اختیاری در development)
GITLAB_WEBHOOK_SECRET=

# CORS — آدرس Frontend (جدا شده با ویرگول در صورت چند مبدأ)
CORS_ORIGINS=http://localhost:3000

# محدودیت نرخ درخواست (درخواست در دقیقه برای هر IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Bootstrap مدیر اولیه ---
# فقط زمانی اعمال می‌شود که هنوز هیچ کاربری در سیستم نباشد.
# پس از ایجاد اولین مدیر، این مقادیر دیگر استفاده نمی‌شوند.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
BOOTSTRAP_ADMIN_FIRST_NAME=مدیر
BOOTSTRAP_ADMIN_LAST_NAME=سیستم
BOOTSTRAP_ORG_NAME=سازمان نمونه

# --- Agent downloads (served by API; baked into Docker image) ---
# Local API without Docker: point at apps/agent/releases after `make prepare-releases`
AGENT_RELEASES_DIR=/app/agent-releases

# --- Frontend ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# آدرس داخلی API برای SSR داخل Docker
INTERNAL_API_URL=http://api:4000/api

# --- سازمان ---
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_LOCALE=fa-IR

# --- Seed توسعه (فقط development؛ در production اجرا نمی‌شود) ---
SEED_DEMO_DATA=false
